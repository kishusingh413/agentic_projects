# Required: LLM for all agents (OpenAI-compatible key used by CrewAI defaults)
OPENAI_API_KEY=sk-...

# Optional: model id (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# If Docker is not available for CodeInterpreterTool, set to true ONLY for trusted code (dev machine).
# CODE_INTERPRETER_UNSAFE=true
