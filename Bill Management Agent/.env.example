# Required to read line items from a receipt photo (you only need the image file; no JSON)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Dev only: use same-stem .json next to the image when API key is missing
BILL_USE_SIDECAR_JSON=0

# Dev only: packaged sample data when API key is missing (use with python -m ... --demo)
BILL_AGENT_DEMO=0
