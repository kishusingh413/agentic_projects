# OpenAI API key (required)
OPENAI_API_KEY=sk-your-api-key-here

# Optional: vision model (default: gpt-4o)
# OPENAI_VISION_MODEL=gpt-4o

# Optional: max tokens for response (default: 4096)
# OPENAI_MAX_TOKENS=4096

# Optional: temperature 0–2 (default: 0.2 for factual output)
# OPENAI_TEMPERATURE=0.2

# Optional: debug mode
# DEBUG=false
