# Copy to .env and fill in values. Choose one LLM provider.

# auto | groq | gemini | ollama | openai
# auto (default): pick first provider that has credentials — openai, then groq, then gemini, then ollama
LLM_PROVIDER=auto

# --- Groq (https://console.groq.com/) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (https://ai.google.dev/) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: custom API base (e.g. proxies); leave empty for api.openai.com
OPENAI_BASE_URL=
