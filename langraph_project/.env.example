# Required: OpenAI-compatible API key (used for parsing and report generation)
OPENAI_API_KEY=sk-...

# Optional: model id (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: custom base URL for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Tavily search (recommended when DuckDuckGo returns no results)
# TAVILY_API_KEY=tvly-...
