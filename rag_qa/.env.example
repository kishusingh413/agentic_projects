# OpenAI API key (required for embeddings and answer generation)
OPENAI_API_KEY=sk-your-api-key-here

# Optional: model for answer generation (default: gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: embedding model (default: text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: max tokens for response (default: 2048)
# OPENAI_MAX_TOKENS=2048

# Optional: temperature 0–2 (default: 0.3 for factual output)
# OPENAI_TEMPERATURE=0.3

# Optional: number of chunks to retrieve (default: 5)
# RAG_TOP_K=5

# Optional: chunk size in characters (default: 1000)
# RAG_CHUNK_SIZE=1000

# Optional: chunk overlap in characters (default: 200)
# RAG_CHUNK_OVERLAP=200
