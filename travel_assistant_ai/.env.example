# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: model id (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# https://www.weatherapi.com/ — free tier API key
WEATHER_API_KEY=your_weatherapi_key

# Attraction search: duckduckgo (default, no extra key) or tavily
# ATTRACTION_SEARCH_PROVIDER=duckduckgo
# https://tavily.com — required when provider is tavily
# TAVILY_API_KEY=your_tavily_key
